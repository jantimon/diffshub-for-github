{
  "name": "diffshub-for-github",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that adds a fast, virtualized diff viewer to GitHub pull requests, built on Pierre's @pierre/diffs components.",
  "author": "Jan Nicklas",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "node test/run-spike.mjs",
    "test:login": "node test/login.mjs",
    "postinstall": "wxt prepare",
    "test:fps": "node test/measure-fps.mjs",
    "test:units": "node test/reconstruct-old-file.mjs && node test/pull-request-paths.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "^1.4.3",
    "@pierre/icons": "^0.9.0",
    "@pierre/theme": "^2.0.0",
    "@pierre/theming": "^1.0.1",
    "@pierre/trees": "^1.0.0-beta.6",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  }
}
