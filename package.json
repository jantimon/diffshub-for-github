{
  "name": "diffshub-for-github",
  "version": "0.1.0",
  "private": true,
  "description": "Browser extension that adds a fast, virtualized diff viewer to GitHub pull requests, built on Pierre's @pierre/diffs components.",
  "author": "Jan Nicklas",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "node scripts/free-firefox.mjs && wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src test scripts wxt.config.ts web-ext.config.ts",
    "format:check": "oxfmt --check src test scripts wxt.config.ts web-ext.config.ts",
    "test": "node test/overlay.mjs",
    "test:live": "DIFFSHUB_HAR=live node test/overlay.mjs",
    "test:record": "DIFFSHUB_HAR=record node test/overlay.mjs",
    "capture:readme": "node test/capture-readme-shots.mjs",
    "test:login": "node test/login.mjs",
    "postinstall": "wxt prepare",
    "test:fps": "node test/measure-fps.mjs",
    "test:units": "node test/reconstruct-old-file.mjs && node test/pull-request-paths.mjs && node test/whitespace.mjs && node test/recording-credentials.mjs",
    "test:review": "node test/review.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "test:firefox": "node test/firefox.mjs",
    "test:whitespace": "node test/ignore-whitespace.mjs"
  },
  "dependencies": {
    "@github/markdown-toolbar-element": "^2.2.3",
    "@pierre/diffs": "^1.4.3",
    "@pierre/icons": "^0.9.0",
    "@pierre/theme": "^2.0.0",
    "@pierre/theming": "^1.0.1",
    "@pierre/trees": "^1.0.0-beta.6",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint-plugin-no-comment-slop": "^0.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  }
}
